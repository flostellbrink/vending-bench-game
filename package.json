{
  "name": "vending-bench-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "pnpm --filter vending-bench-game generate",
    "dev": "pnpm generate && pnpm --filter vending-bench-game dev",
    "build": "pnpm generate && pnpm --filter vending-bench-game build",
    "test": "pnpm generate && pnpm --filter vending-bench-game test",
    "typecheck": "pnpm generate && pnpm --filter vending-bench-game typegen && tsc -b",
    "quality:check": "node apps/web/scripts/check-source.ts && pnpm typecheck && pnpm quality:check:lint && pnpm quality:check:format && pnpm --filter vending-bench-game test",
    "quality:check:format": "oxfmt --check",
    "quality:fix:format": "oxfmt",
    "quality:check:lint": "oxlint"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.5.1"
}
